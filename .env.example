# =====================================================================
# Multimodal Knee Osteoporosis Classification - Environment Variables
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
USE_CUDA=0  # Set to 1 if NVIDIA GPU with CUDA is available

# CORS Configuration (comma-separated allowed origins)
# For local dev: http://localhost:5173,http://127.0.0.1:5173
# For production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# File Paths (defaults to repository paths)
CHECKPOINTS_DIR=outputs/checkpoints
REPORTS_DIR=outputs/reports
FIGURES_DIR=outputs/figures
GRADCAM_DIR=outputs/gradcam_examples
DATA_DIR=data

# Frontend (for separate frontend deployment)
# VITE_API_BASE_URL=https://your-backend-api.com
